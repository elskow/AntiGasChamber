# Copy to .env (gitignored). Values are read from the environment first;
# the file only fills in what is not already set.

# Required in production. Unset = random per-process dev secret.
AGC_TOKEN_SECRET=change-me-to-a-long-random-string
AGC_TOKEN_HOURS=24

# Listeners and database
AGC_HTTP_ADDRESS=:8080
AGC_MQTT_ADDRESS=:1883
AGC_DATABASE=agc.db

# Optional. When set, POST /api/v1/users requires this code in the body.
AGC_PROVISION_CODE=

# Credentials the backend uses to connect to its own embedded broker
AGC_BACKEND_USER=backend
AGC_BACKEND_PASSWORD=change-me

# Android push (FCM). Unset = dry-run logging.
AGC_FCM_PROJECT_ID=

# iOS push (APNs). Unset key path = dry-run logging.
AGC_APNS_KEY_PATH=
AGC_APNS_KEY_ID=
AGC_APNS_TEAM_ID=
AGC_APNS_BUNDLE_ID=org.unesa.agc.AntiGasChamber
AGC_APNS_PRODUCTION=0

# Alert engine: minimum interval between raised alerts for the same device.
AGC_MIN_ALERT_INTERVAL=10m

# Readings retention: readings older than this are pruned hourly.
AGC_READING_RETENTION=720h
